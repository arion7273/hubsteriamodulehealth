# Module Health server (local). Copy to `.env` — never commit `.env`.

# Vercel AI Gateway (https://vercel.com/docs/ai-gateway)
AI_GATEWAY_API_KEY=

# Optional alias:
# VERCEL_AI_API_KEY=

AI_GATEWAY_MODEL=openai/gpt-4o-mini
# AI_GATEWAY_BASE_URL=https://gateway.ai.vercel.app/v1
# MODULE_HEALTH_PUBLIC_URL=http://127.0.0.1:4177
