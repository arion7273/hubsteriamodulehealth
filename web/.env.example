# Public URL of the Module Health API (Node + Playwright), e.g. https://your-api.railway.app
# Leave empty when UI and API are served together (npm start).
VITE_API_BASE=

# Vercel only (not Vite): set in Project → Environment Variables as SCANNER_API_ORIGIN
