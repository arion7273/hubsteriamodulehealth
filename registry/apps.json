      "environments": [
        {
          "id": "local",
          "label": "Local fixture",
          "baseUrl": "http://127.0.0.1:4177/fixtures/defect-app/index.html",
          "mutationsAllowed": false
        }
      ],
      "modules": [
        { "id": "home", "label": "Home", "routes": ["/"], "status": "present" },
        { "id": "forms", "label": "Forms", "routes": ["/form.html"], "status": "present" },
        { "id": "mobile", "label": "Mobile layout", "routes": ["/mobile.html"], "status": "present" }
      ],
      "criticalWorkflows": [],
