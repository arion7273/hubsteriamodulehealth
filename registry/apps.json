      "baseUrl": "http://127.0.0.1:4177/fixtures/workflow-app/create.html",
      "environments": [
        {
          "id": "local",
          "label": "Local workflow fixture",
          "baseUrl": "http://127.0.0.1:4177/fixtures/workflow-app/create.html",
          "mutationsAllowed": true
        }
      ],
      "modules": [
        { "id": "records", "label": "Records", "routes": ["/create.html", "/list.html"], "status": "present" },
        { "id": "access", "label": "Access control", "routes": ["/roles.html"], "status": "present" }
      ],
      "criticalWorkflows": [
        "gap-create-persist",
        "gap-edit-downstream",
