      ],
      "modules": [],
      "criticalWorkflows": [],
      "testAccountRefs": [],
      "integrations": [],
      "schedules": { "enabled": false },
      "budgets": { "pageLimit": 12, "timeoutMs": 45000 },
      "buildId": null
    },
    {
      "id": "adapter-fixture-repo",
      "name": "Adapter fixture repository",
      "description": "Controlled repo with lint, type, secret, and semgrep fixtures",
      "repositoryPath": "fixtures/sample-repo",
      "baseUrl": null,
      "environments": [
        { "id": "local", "label": "Fixture checkout", "baseUrl": null, "mutationsAllowed": false }
      ],
      "modules": [],
      "criticalWorkflows": [],
      "testAccountRefs": [],
      "integrations": [],
      "schedules": { "enabled": false },
      "budgets": { "eslintPaths": ["src"], "semgrepConfig": null },
      "buildId": "adapter-fixture"
    },
    {
      "id": "defect-fixture",
      "name": "Defect Fixture (internal)",
