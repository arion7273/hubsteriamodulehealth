{
  "name": "hubsteriamodulehealth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Module Health Suite — micro-checks, extensive reports, and safe auto-fixes for Hubsteria modules",
  "bin": {
    "module-health": "./scripts/run-module-health.mjs"
  },
  "scripts": {
    "module:health": "node scripts/run-module-health.mjs",
    "module:health:fix": "node scripts/run-module-health.mjs --fix",
    "module:health:example": "node scripts/run-module-health.mjs --manifest modules.manifest.json",
    "build:web": "npm install --prefix web && npm run build --prefix web",
    "start": "node server/index.mjs",
    "start:prod": "npm run build:web && NODE_ENV=production node server/index.mjs",
    "dev:server": "node server/index.mjs",
    "verify:platform": "node scripts/verify-platform.mjs",
    "verify:adapters": "node scripts/verify-adapters.mjs",
    "verify:zap": "node scripts/verify-zap.mjs",
    "verify:reports": "node scripts/verify-report-consistency.mjs",
    "verify:comparison": "node scripts/verify-report-comparison.mjs",
    "verify:workflows": "node scripts/verify-workflow-executor.mjs",
    "verify:workflows-regression": "node scripts/verify-workflow-regression.mjs",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "verify:repair-e2e": "node scripts/verify-repair-e2e.mjs",
    "test:ai": "node scripts/test-ai-gateway.mjs",
    "migrate:export": "node scripts/migrate-cloud-export.mjs",
    "migrate:import": "node scripts/migrate-cloud-import.mjs",
    "test": "node scripts/run-test-suite.mjs",
    "test:code-health": "node --test tests/code-health/*.test.mjs",
    "health:audit": "node scripts/code-health-cli.mjs audit",
    "health:compare": "node scripts/code-health-cli.mjs compare",
    "health:plan": "node scripts/code-health-cli.mjs plan",
    "health:baseline": "node scripts/code-health-cli.mjs baseline"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lighthouse": "^12.2.1",
    "node-cron": "^3.0.3",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "jscpd": "5.4.1",
    "knip": "6.41.0"
  }
}
